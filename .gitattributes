# Ensure bash scripts always use LF so they run correctly under WSL / Git Bash / macOS / Linux,
# even when cloned on Windows with core.autocrlf=true.
*.sh   text eol=lf

# PowerShell and notebooks: normalize to LF in the repo; Git/PowerShell handle either EOL fine.
*.ps1  text eol=lf
*.ipynb text eol=lf

# Markdown / config: normalized text.
*.md   text

# The .env config is sourced directly by the bash scripts, so it must be LF
# (CRLF would inject a trailing $'\r' into every value / break `source`).
*.env  text eol=lf
# The template is copied to variables.env and sourced too — keep it LF as well
# (the *.env rule above does not match the .example suffix).
*.env.example  text eol=lf
