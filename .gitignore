# Data files (don't commit large zips/CSVs)
*.zip
*.csv
*.parquet

# Temp files from deployment
/tmp/
/.tmp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Python venv
.venv/
__pycache__/

# Azure/Fabric tokens
*.token
.env

# Local deploy config with real values (copy from config/variables.env.example).
# The .example template IS committed; the filled-in file is not.
config/variables.env
