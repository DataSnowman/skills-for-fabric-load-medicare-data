# =============================================================================
# Medicare Part D deploy — configuration
#
# This is the ONE file you edit. Both the PowerShell (*.ps1) and bash (*.sh)
# scripts read these values automatically. Format is plain KEY=value (like a
# .env file): put the value after the = sign, no quotes needed.
# =============================================================================

# ── Existing workspace (most people start here) ──────────────────────────────
# Your existing Fabric workspace GUID. Find it in the workspace URL:
#   https://app.fabric.microsoft.com/groups/<WS_ID>/...
WS_ID=de7d33d7-a5cb-496a-a831-0e0fc2341613

# Name of the Lakehouse the scripts create in that workspace.
LAKEHOUSE_NAME=MedicarePartD


# ── Full deployment only (admins) ────────────────────────────────────────────
# Only used by deploy-medicare-e2e.* , which CREATES the Azure Resource Group,
# Fabric Capacity, and Workspace from scratch. Ignore this whole section if you
# are deploying into an existing workspace above.
RESOURCE_GROUP=FabricCapacityWestUS3
LOCATION=westus3
SKU=F4
CAPACITY_NAME=fabricappsf4
WORKSPACE_NAME=ZavaPharma
