# =============================================================================
# Medicare Part D deploy — configuration TEMPLATE
#
# Copy this file to config/variables.env, then fill in your values:
#     cp config/variables.env.example config/variables.env      # bash
#     Copy-Item config/variables.env.example config/variables.env  # PowerShell
#
# config/variables.env is gitignored, so your values (and workspace IDs) stay
# local and never get committed. Both the PowerShell (*.ps1) and bash (*.sh)
# scripts read config/variables.env automatically. Format is plain KEY=value
# (like a .env file): put the value after the = sign, no quotes needed.
# =============================================================================

# ── Existing workspace (most people start here) ──────────────────────────────
# Your existing Fabric workspace GUID. Find it in the workspace URL:
#   https://app.fabric.microsoft.com/groups/<WS_ID>/...
WS_ID=

# Name of the Lakehouse the scripts create in that workspace.
LAKEHOUSE_NAME=MedicarePartD


# ── Full deployment only (admins) ────────────────────────────────────────────
# Only used by deploy-medicare-e2e.* , which CREATES the Azure Resource Group,
# Fabric Capacity, and Workspace from scratch. Ignore this whole section if you
# are deploying into an existing workspace above.
RESOURCE_GROUP=my-fabric-rg
LOCATION=westus3
SKU=F4
CAPACITY_NAME=myfabriccapacity
WORKSPACE_NAME=MyFabricWorkspace
